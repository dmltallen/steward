{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": ["src/lib/**/*.ts", "tests/**/*.ts"],
  "exclude": ["src/lib/storage.ts", "node_modules"]
}
