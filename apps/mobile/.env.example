# Copy this file to .env to point the app at a Steward daemon on your LAN.
# The value is read at bundle time by Expo (EXPO_PUBLIC_ prefix) and is safe
# to commit: it is just the host and port of a local daemon, no secrets.
# Default when unset: http://127.0.0.1:3876
EXPO_PUBLIC_STEWARD_DAEMON_URL=http://127.0.0.1:3876
